# =============================================================================
# Environment Variables - Real-Time Customer Support Chat Platform
# =============================================================================
# Copy this file to .env and fill in the values.
# Documentation: Each variable includes a description of its purpose.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development                    # 'development' | 'production' | 'test'
PORT=3001                              # Backend server port
SESSION_SECRET=your-session-secret     # Secret for signing session cookies (change in production!)
FRONTEND_URL=http://localhost:5173     # Frontend URL for CORS (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173     # Allowed CORS origins (comma-separated)

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/messaging  # MongoDB connection string
# For Docker with replica set:
# MONGODB_URI=mongodb://localhost:27017/messaging?replicaSet=rs0&directConnection=true

# MongoDB credentials (used by docker-compose)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379       # Redis connection string
# For Docker with password:
# REDIS_URL=redis://:redis123@localhost:6379

# Redis password (used by docker-compose)
REDIS_PASSWORD=redis123

# -----------------------------------------------------------------------------
# Web Push Notifications (VAPID)
# -----------------------------------------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=                      # VAPID public key for push notifications
VAPID_PRIVATE_KEY=                     # VAPID private key for push notifications
VAPID_EMAIL=mailto:admin@example.com   # Contact email for VAPID

# -----------------------------------------------------------------------------
# Frontend Environment Variables (prefix with VITE_)
# -----------------------------------------------------------------------------
# These are set in apps/frontend/.env or apps/frontend/.env.local

# API Configuration
VITE_API_URL=/api/v1                   # Backend API URL (use /api/v1 for proxy)
VITE_WS_URL=http://localhost:3001      # WebSocket server URL (for Socket.IO)

# Push Notifications
VITE_VAPID_PUBLIC_KEY=                 # VAPID public key (same as backend)
