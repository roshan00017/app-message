# Frontend Environment Variables
# Copy this file to .env.local and fill in the values.

# API Configuration
VITE_API_URL=/api/v1                   # Backend API URL (use proxy in development)
VITE_WS_URL=http://localhost:3001      # WebSocket server URL for Socket.IO

# Push Notifications (Web Push VAPID public key)
VITE_VAPID_PUBLIC_KEY=                 # Get from backend .env VAPID_PUBLIC_KEY
